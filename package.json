{
  "name": "@nnilky/structo",
  "description": "A library for serializing and deserializing binary content",
  "keywords": [
    "binary",
    "library",
    "utility",
    "web",
    "node"
  ],
  "license": "ISC",
  "version": "1.5.0",
  "author": "Ben Brady",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ben-Brady/structo-ts.git"
  },
  "readme": "README.md",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "default": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./index.js": {
      "default": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "./dist/**/*.d.ts",
    "./dist/**/*.js.map",
    "./dist/**/*.js"
  ],
  "scripts": {
    "build": "tsc",
    "prepublish": "tsc",
    "check": "tsc --noEmit",
    "docs:generate": "typedoc --options ./reference/typedoc.json",
    "docs:watch": "typedoc --watch --options ./reference/typedoc.json",
    "test": "vitest run",
    "test:update": "vitest run --update all",
    "test:coverage": "vitest run --coverage --coverage.reportsDirectory /tmp/coverage"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "5.1.0",
    "jest": "^30.4.2",
    "tsx": "^4.23.0",
    "typedoc": "^0.28.20",
    "typedoc-material-theme": "^1.4.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.13.1"
}
