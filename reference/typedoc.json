{
    "categorizeByGroup": true,
    "sourceLinkExternal": false,
    "includeVersion": true,
    "navigation": {
        "excludeReferences": true,
        "compactFolders": true,
        "includeGroups": true,
        "includeCategories": false,
        "includeFolders": false
    },

    "groupReferencesByType": true,
    "plugin": ["typedoc-material-theme"],
    "themeColor": "#cb9820",
    "entryPoints": ["../src/index.ts"],

    "out": "../docs",
    "projectDocuments": ["./documents/*.md"],

    "sort": ["kind", "source-order", "alphabetical"],
    "groupOrder": [
        "Functions",
        "Types",
        "Number",
        "String / Bytes",
        "Object",
        "Array",
        "Transforms",
        "Utilities",
        "Memory"
    ],
    "intentionallyNotExported": [
        "InferObject",
        "InferUnion",
        "TypedArray",
        "TypedArrayLike",
        "ExpectType"
    ]
}
