{
    "entryPoints": ["../src/index.ts"],
    "out": "../docs",
    "readme": "./README.md",

    "groupOrder": [
        "Functions",
        "Types",
        "Type Helpers",
        "Number",
        "String / Bytes",
        "Array",
        "Object"
