{
    "categorizeByGroup": true,
    "sourceLinkExternal": false,
    "includeVersion": true,
    "navigation": {
        "includeGroups": true,
        "includeCategories": false,
        "includeFolders": false
    },
    "plugin": ["typedoc-material-theme"],
    "themeColor": "#cb9820",
    "customCss": "./docs.css",
    "entryPoints": ["../src/index.ts"],

    "out": "../docs",
    "readme": "./README.md",
    // "projectDocuments": ["./documents/*.md"],

    "sort": ["kind", "source-order", "alphabetical"],
    "groupOrder": [
        "Functions",
        "Types",
        "Type Helpers",
        "Number",
        "String / Bytes",
        "Array",
        "Object"
    ],
    "intentionallyNotExported": [
        "InferObjectInput",
        "InferObjectOutput",
        "InferUnionInput",
        "InferUnionOutput",
        "TypedArray",
        "TypedArrayLike"
    ]
}
